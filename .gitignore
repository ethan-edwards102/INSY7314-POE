# Dependency directories (never commit these)
node_modules/
jspm_packages/
web_modules/

# Local environment variables (contains secrets, database passwords, keys)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Debug and log files
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# Diagnostic reports
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json

# Process managers and tools
.pids
*.pid
*.seed
*.pid.lock

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Optional REPL history
.node_repl_history

# Output of 'npm pack'
*.tgz

# Yarn Integrity file
.yarn-integrity

# Operating system files
.DS_Store
Thumbs.db

# IDE files
.idea/

# Production / Build output (uncomment if using TypeScript/build tools)
# dist/
# build/
