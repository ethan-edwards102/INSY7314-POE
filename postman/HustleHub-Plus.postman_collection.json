    {
      "name": "3. Login",
      "description": "Written against the agreed contract ahead of the login endpoint being built. While POST /auth/login returns 404 these assertions report as skipped.",
      "item": [
        {
          "name": "Log in with valid credentials",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "pm.test('Returns a JWT', function () {",
                  "    var token = pm.response.json().token;",
                  "    pm.expect(token).to.be.a('string');",
                  "    pm.expect(token.split('.')).to.have.lengthOf(3);",
                  "    pm.collectionVariables.set('authToken', token);",
                  "});",
                  "",
                  "pm.test('Token payload carries the id and role', function () {",
                  "    var payload = JSON.parse(atob(pm.response.json().token.split('.')[1]));",
                  "    pm.expect(payload).to.have.property('id');",
                  "    pm.expect(payload).to.have.property('role');",
                  "});",
                  "",
                  "pm.test('Token payload carries no password hash', function () {",
                  "    pm.expect(pm.response.text()).to.not.include('$2b$');",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
