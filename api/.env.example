PORT=5001
MONGO_URI=mongodb://127.0.0.1:27017/hustle_hub_plus
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost-cert.pem
JWT_SECRET=GENERATE_ME
JWT_EXPIRES_IN=1h

# Used only by `npm run seed:admin` to create the first Admin account.
# The API cannot create one: registration refuses the role and changing a role
# is itself Admin-only, so the first Admin is bootstrapped out of band.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=CHANGE_ME
