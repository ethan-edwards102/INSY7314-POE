# Copy this file to .env, then set each value.

# The port of the HTTPS server.
PORT=5001
# The connection string of the MongoDB database.
MONGO_URI=mongodb://127.0.0.1:27017/hustle_hub_plus

# Run "npm run certs" to make the TLS key and certificate.
SSL_KEY_PATH=./certs/localhost-key.pem
SSL_CERT_PATH=./certs/localhost-cert.pem

# The secret that signs each token.
# The API does not start while the value is GENERATE_ME.
# Make a secret with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=GENERATE_ME
# The time that a token stays valid.
JWT_EXPIRES_IN=1h

# These values make the first Admin account.
# Only "npm run seed:admin" reads these values.
# Replace CHANGE_ME with a strong password.
ADMIN_NAME=Site Admin
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=CHANGE_ME

# You can leave out each value below, because the API has a default for it.

# The browser origins that the API accepts, with a comma between each origin.
CLIENT_ORIGIN=https://localhost:5173

# Set NODE_ENV to production on a live server to turn off the /docs page.
# NODE_ENV=production

# Each rate limit has a window in minutes and a maximum count.
# All requests from one IP address.
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=15
RATE_LIMIT_GLOBAL_MAX=300
# Failed logins for one IP address and one email.
RATE_LIMIT_LOGIN_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_MAX=5
# Failed logins for one IP address across all emails.
RATE_LIMIT_LOGIN_IP_WINDOW_MINUTES=15
RATE_LIMIT_LOGIN_IP_MAX=20
# Registrations from one IP address.
RATE_LIMIT_REGISTER_WINDOW_MINUTES=60
RATE_LIMIT_REGISTER_MAX=20
# Booking attempts by one signed in user.
RATE_LIMIT_BOOKING_WINDOW_MINUTES=10
RATE_LIMIT_BOOKING_MAX=10
